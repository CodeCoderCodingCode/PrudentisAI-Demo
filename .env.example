# Copy to .env for the full application. The component preview needs no keys.
# Database (Prisma loads .env; use the same URL twice without a pooler)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/prudentis?schema=public"
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/prudentis?schema=public"

# Clerk development instance
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/dashboard
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/dashboard

# Required by the existing middleware and transaction rate limiting
ARCJET_KEY=

# Optional integrations; required only for their respective features
GEMINI_API_KEY=
# Both receipt scanning and reports use this model. Verify access with your key.
GEMINI_MODEL=gemini-3.8-flash
RESEND_API_KEY=
# This spelling intentionally matches app/api/exchangeRates/route.js.
OPEN_EXCANGE_API_KEY=

# Inngest Cloud deployment only; the local Dev Server needs neither key.
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=
